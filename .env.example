# =============================================================================
# EVINA pin-auth live-test frontend — configuration
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# pin-auth target
# -----------------------------------------------------------------------------

# Base URL of the pin-auth service (NO trailing slash).
# This is the confirmed internal v2 host + prefix:
PIN_AUTH_BASE=https://idm-op-app-01.ideabiz.lk/ib-int/pin-api/v1

# Endpoint paths appended to PIN_AUTH_BASE. Defaults match the v2 controller.
SUBSCRIBE_PATH=/pin/subscription/v2/subscribe
SUBMIT_PATH=/pin/subscription/v2/submitPin

# If PIN_AUTH_BASE uses https with a self-signed / internal CA cert and the
# proxy cannot validate it, set this to "1" to skip TLS verification.
# ONLY for internal testing. Leave empty (secure) by default.
INSECURE_TLS=

# -----------------------------------------------------------------------------
# Authentication — the v2 endpoints require an X-JWT-Assertion header.
# pin-auth's JWT.tokenInfo() only base64url-decodes the payload to read
# `applicationid`; it does NOT verify the signature. So we build an unsigned
# WSO2-style token from your app id (the recommended path).
# -----------------------------------------------------------------------------

# Auth mode: "jwt-assertion" (default, internal v2) or "bearer" (public gateway).
AUTH_MODE=jwt-assertion

# For AUTH_MODE=jwt-assertion: the SUBSCRIPTION app id that exists in pin-auth's
# DB. The harness builds the X-JWT-Assertion header from this automatically.
PIN_AUTH_APP_ID=

# Escape hatch: paste a full X-JWT-Assertion token to send verbatim instead of
# building one from PIN_AUTH_APP_ID. Leave empty unless you need a specific one.
PIN_AUTH_JWT=

# For AUTH_MODE=bearer: an OAuth access token (sent as `Authorization: Bearer`).
# Only used when AUTH_MODE=bearer (e.g. testing the public ideabiz.lk gateway).
BEARER_TOKEN=

# -----------------------------------------------------------------------------
# Request shape
# -----------------------------------------------------------------------------

# Optional serviceId. Leave EMPTY to use the app's default config.
PIN_AUTH_SERVICE_ID=e8e4a060-4651-4b3d-90b3-e3a1e76e5cb1

# Optional language header for the PIN SMS template (sin | tam | empty).
LANGUAGE=

# CSS selector the EVINA kit must watch. MUST match evina.default.selector in
# pin-auth. The frontend's submit button already uses this id.
TARGET_SELECTOR=#submit-pin

# -----------------------------------------------------------------------------
# This server
# -----------------------------------------------------------------------------

# Port this frontend+proxy listens on. Binds 0.0.0.0 so it's reachable via DNS.
PORT=4100

# Log verbosity: debug | info | warn | error. Use debug while troubleshooting.
LOG_LEVEL=debug
