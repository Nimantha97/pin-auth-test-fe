{
  "name": "evina-pin-test-fe",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone frontend + server-side proxy to live-test the EVINA anti-fraud flow against the internal pin-auth v2 subscribe/submitPin endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "serve": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
